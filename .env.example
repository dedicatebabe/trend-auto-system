# ==========================================
# Version: 1.1.0
# Date: 2026-09-13
# Summary: 一般向けトレンド自動投稿の環境変数サンプル
# ==========================================

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key

# X (Twitter) API v2 OAuth 1.0a User Context
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret

# GitHub Pages 公開ベース URL（末尾スラッシュなし）
BASE_URL=https://dedicatebabe.github.io/trend-auto-system

# 任意: ASP承認後のアフィリエイトURLテンプレ（{keyword} がURLエンコード済み語に置換）
# 未設定時は公式の検索URLを使用
# MERCARI_URL_TEMPLATE=https://jp.mercari.com/search?keyword={keyword}
# SURUGAYA_URL_TEMPLATE=https://www.suruga-ya.jp/search?category=&search_word={keyword}
